[Unit]
Description=StateLamp touch kiosk on tty2
After=statelamp-console@%i.service systemd-user-sessions.service getty.target
Requires=statelamp-console@%i.service
Conflicts=getty@tty2.service

[Service]
Type=simple
User=%i
PAMName=login
WorkingDirectory=/opt/statelamp
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/opt/statelamp/hardware/raspberry-pi/console/launch-kiosk.sh
Restart=always
RestartSec=2
TimeoutStopSec=10
TTYPath=/dev/tty2
StandardInput=tty-force
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
