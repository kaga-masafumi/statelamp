[Unit]
Description=StateLamp Linux Console server
After=network.target statelamp-bridge@%i.service
Wants=statelamp-bridge@%i.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/statelamp
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 hardware/raspberry-pi/console/server.py --host 127.0.0.1 --port 18880 --bridge-url http://127.0.0.1:18480
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
